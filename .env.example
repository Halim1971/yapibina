# Uygulama ortamı: development, testing veya production
APP_ENV=development

# Production için en az 32 karakterli, rastgele ve gizli bir değer kullanın.
SECRET_KEY=change-me

# Production PostgreSQL örneği (gerçek kullanıcı/parola içermez):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/yapibina

SERVER_NAME=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=10485760
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_CURRENCY=TRY
PLATFORM_HOSTNAME=platform.yapibina.com
BASE_TENANT_DOMAIN=yapibina.com
